# Example retained named configuration. Enable it when OW-09 daemon is present.
# UCI names are case-sensitive: 'savage' and 'SAVAGE' are distinct parents.
#
# config process 'savage'
#     option name 'savage'
#
# config address_family
#     option process 'savage'
#     option afi 'ipv4'
#     option asn '4453'
#     option shutdown '0'
#
# config network
#     option process 'savage'
#     option afi 'ipv4'
#     option asn '4453'
#     option prefix '10.0.0.0/8'
#
# config interface
#     option process 'savage'
#     option afi 'ipv4'
#     option asn '4453'
#     option ifname 'br-lan'
#     option hello_interval '5'
#     option hold_time '15'
