diff --git a/yang/frr-eigrpd.yang b/yang/frr-eigrpd.yang
index 8491bfc..710a5a7 100644
--- a/yang/frr-eigrpd.yang
+++ b/yang/frr-eigrpd.yang
@@ -290,6 +290,52 @@ module frr-eigrpd {
         }
       }
     }
+
+    /*
+     * EIGRP named-mode configuration.  This is intentionally separate from
+     * the legacy numeric-AS instance list because one named parent may own
+     * multiple IPv4/IPv6 address-family contexts.
+     */
+    list named {
+      key "name";
+      description "EIGRP named-mode parent process";
+
+      leaf name {
+        type string {
+          length "1..64";
+        }
+        description "Case-sensitive local EIGRP process name";
+      }
+
+      list address-family {
+        key "afi vrf asn";
+        description "Address-family protocol context owned by a named process";
+
+        leaf afi {
+          type enumeration {
+            enum ipv4 {
+              value 4;
+              description "IPv4 unicast address family";
+            }
+            enum ipv6 {
+              value 6;
+              description "IPv6 unicast address family";
+            }
+          }
+          description "Network-layer address family";
+        }
+
+        leaf vrf {
+          type frr-vrf:vrf-ref;
+          description "Virtual Routing Domain name";
+        }
+
+        leaf asn {
+          type autonomous-system;
+          description "EIGRP autonomous-system number for this address family";
+        }
+      }
+    }
   }
 
