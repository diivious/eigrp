diff --git a/yang/frr-eigrpd.yang b/yang/frr-eigrpd.yang
index 710a5a7..7ca0296 100644
--- a/yang/frr-eigrpd.yang
+++ b/yang/frr-eigrpd.yang
@@ -418,4 +418,42 @@ module frr-eigrpd {
        }
      }
    }
+
+  /*
+   * Named-mode address-family configuration is augmented separately from
+   * the parent/key patch so FRR patch detection remains independently
+   * reversible as named-mode coverage grows.
+   */
+  augment "/eigrpd/named/address-family" {
+    leaf router-id {
+      type inet:ipv4-address;
+      description "Router identification for this address-family context";
+    }
+
+    leaf-list network {
+      type inet:ipv4-prefix;
+      description "IPv4 networks enabled in this named address family";
+    }
+
+    list neighbor {
+      key "address interface";
+      description "Static EIGRP neighbor for this named address family";
+
+      leaf address {
+        type inet:ip-address;
+        description "Neighbor IPv4 or IPv6 address";
+      }
+
+      leaf interface {
+        type frr-interface:interface-ref;
+        description "Interface used to reach the configured neighbor";
+      }
+    }
+
+    leaf shutdown {
+      type empty;
+      description "Administratively disable this address-family context";
+    }
+  }
+
 }
