#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Donnie V. Savage

START=75
STOP=20
USE_PROCD=1
PROG=/usr/sbin/openeigrpd

start_service() {
	# Never launch an invalid configuration into procd's restart cycle.
	"$PROG" --check || return 1
	procd_open_instance
	procd_set_param command "$PROG" --foreground
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_set_param reload_signal SIGHUP
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/openeigrp
	procd_close_instance
}

reload_service() {
	# Failed validation leaves the existing service and its config untouched.
	"$PROG" --check || return 1
	procd_send_signal openeigrp
}

service_triggers() {
	procd_add_reload_trigger openeigrp
}
