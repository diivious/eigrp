# OpenEIGRP Docker defaults. Zebra, mgmtd and staticd are FRR-mandatory.
# Persist this file with frr.conf when mounting /etc/frr.
bgpd=no
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=yes
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no
vtysh_enable=yes
zebra_options="-A 127.0.0.1"
mgmtd_options="-A 127.0.0.1"
eigrpd_options="-A 127.0.0.1"
staticd_options="-A 127.0.0.1"
